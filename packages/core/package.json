{
  "name": "l10n-tools-core",
  "version": "8.4.2",
  "description": "Localization tools - Core library and infrastructure",
  "type": "module",
  "engines": {
    "node": ">=22.19.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "tsx --conditions source --test \"src/**/*.test.ts\"",
    "schema": "tsx --conditions source scripts/generate-schema.ts"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin-types": {
      "source": "./src/plugin-types.ts",
      "types": "./dist/plugin-types.d.ts",
      "import": "./dist/plugin-types.js"
    }
  },
  "files": [
    "dist",
    "l10nrc.schema.json"
  ],
  "dependencies": {
    "npmlog": "^7.0.1",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/npmlog": "^7.0.0"
  },
  "author": "Eungkyu Song <eungkyu@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tpcint/l10n-tools.git",
    "directory": "packages/core"
  }
}
